{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Haval LocalAI Benchmarking",
  "version": "0.1.0",
  "identifier": "com.haval.localaibench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Haval LocalAI Benchmarking",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
    "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": [
      "../../config",
      "../../engine/haval_engine",
      "../../engine/requirements.txt",
      "../../LICENSE"
    ],
    "copyright": "Copyright (c) 2026 Haval Othman",
    "shortDescription": "Haval LocalAI Benchmarking — local model evaluation for Windows",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "compression": "lzma",
        "languages": ["English"],
        "template": "../../installer/nsis/installer.nsi",
        "installerHooks": "../../installer/nsis/hooks.nsh",
        "headerImage": "../../installer/assets/bmp/header.bmp",
        "sidebarImage": "../../installer/assets/bmp/sidebar.bmp",
        "installerIcon": "../../installer/assets/bmp/wizard.ico",
        "uninstallerIcon": "../../installer/assets/bmp/wizard.ico",
        "uninstallerHeaderImage": "../../installer/assets/bmp/header.bmp",
        "customLanguageFiles": {
          "English": "../../installer/nsis/English.nsh"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
