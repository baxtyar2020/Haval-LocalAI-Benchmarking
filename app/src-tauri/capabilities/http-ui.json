{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "http-ui",
  "description": "IPC when the WebView is on 127.0.0.1 (localhost plugin)",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "opener:default"
  ]
}
